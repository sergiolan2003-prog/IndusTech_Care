#include <iostream>

using namespace std;

// Estructura Rectangulo
struct Rectangulo {
    float ancho;
    float alto;
};

int main() {
    int n;

    // Pedir al usuario cuantos rectangulos quiere crear
    cout << "Ingrese el numero de rectangulos: ";
    cin >> n;

    // Crear un arreglo dinamico de rectangulos
    Rectangulo* rectangulos = new Rectangulo[n];

    // Ingresar los datos de cada rectangulo y calcular su area
    for (int i = 0; i < n; ++i) {
        cout << "Ingrese el ancho del rectangulo " << i + 1 << ": ";
        cin >> rectangulos[i].ancho;
        cout << "Ingrese el alto del rectangulo " << i + 1 << ": ";
        cin >> rectangulos[i].alto;

        // Calcular el area del rectangulo
        float area = rectangulos[i].ancho * rectangulos[i].alto;
        cout << "Area del rectangulo " << i + 1 << ": " << area << endl;
    }

    // Liberar la memoria del arreglo dinamico
    delete[] rectangulos;

    return 0;
}
