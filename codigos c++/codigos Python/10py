class Factura:
    def __init__(self, cliente, productos):
        self.cliente = cliente
        self.productos = productos  # Lista de tuplas (nombre, precio)

    def calcular_total(self, impuesto=0.15):
        subtotal = sum(precio for _, precio in self.productos)
        return subtotal * (1 + impuesto)

    def mostrar_factura(self):
        print(f"Cliente: {self.cliente}")
        for producto, precio in self.productos:
            print(f"  {producto}: ${precio}")
        print(f"Total con impuestos: ${self.calcular_total()}")

# Diccionario de facturas
facturas = {
    "001": Factura("Juan Perez", [("Camisa", 20), ("Pantalón", 30)]),
    "002": Factura("Ana Gomez", [("Zapatos", 50), ("Bufanda", 15)])
}

# Mostrar facturas
for numero, factura in facturas.items():
    print(f"Factura {numero}:")
    factura.mostrar_factura()